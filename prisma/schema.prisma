// にいみコミュニティ メンバーズ - データベーススキーマ
//
// 設計方針:
// - 個人情報は最小限（氏名・表示名・メールのみ）に絞り、住所や電話番号は収集しない
// - パスワードは平文で保存せず bcrypt ハッシュのみを保持する（passwordHashカラム）
// - 会員・コンテンツは可能な限り論理削除（deletedAt / isActive）とし、誤操作からの復旧余地を残す
// - 会員種別(MembershipPlan)は各コンテンツに配列で許可リストを持たせ、階層でなく明示的に判定する
// - 将来のOAuth(Google/LINE)ログイン拡張に備え、Auth.js標準の Account / Session モデルを採用する

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 本番環境: PostgreSQL（Vercel Postgres / Supabase / Neon 等）
  // ※ SQLite は enum 型未対応のため本番では使用不可
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// 認証・会員
// ─────────────────────────────────────────

enum MembershipPlan {
  FREE // 無料会員
  STANDARD // 通常会員
  PREMIUM // プレミアム会員
  ADMIN // 管理者
}

enum MemberStatus {
  ACTIVE // 有効
  SUSPENDED // 一時停止
  WITHDRAWN // 退会
  EXPIRED // 有効期限切れ
}

// Auth.js が要求する User モデル。認証の本体。
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // ログイン用ID（メールアドレスと別に発行可能。会員ごとに個別発行し、使い回さない）
  loginId      String @unique
  passwordHash String // bcryptハッシュのみ保持。平文は一切保存しない。

  name        String // 氏名（管理者のみ閲覧可能な想定の項目は将来 MemberProfile 側で分離)
  displayName String // 表示画面に出す名前（挨拶等に使用）

  membershipPlan MembershipPlan @default(FREE)
  status         MemberStatus   @default(ACTIVE)

  registeredAt DateTime  @default(now())
  expiresAt    DateTime? // 有効期限（nullは無期限）
  lastLoginAt  DateTime?

  // ログイン失敗回数・ロック（ブルートフォース対策）
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // 仮パスワード発行時にtrue。ログイン後に変更を促す
  mustChangePassword Boolean @default(false)

  mustResetToken       String? @unique // パスワード再設定用トークン
  mustResetTokenExpiry DateTime?

  deletedAt DateTime? // 論理削除（退会等）

  profile MemberProfile?

  accounts Account[]
  sessions Session[]

  videoViews       VideoView[]
  videoFavorites   VideoFavorite[]
  articleViews     ArticleView[]
  articleFavorites ArticleFavorite[]
  announcementReads AnnouncementRead[]
  downloadLogs     DownloadLog[]
  adminLogs        AdminLog[] @relation("AdminLogActor")

  pointEvents       PointEvent[]         @relation("PointEvents")
  chatMessages      ChatMessage[]        @relation("ChatMessages")
  chatReactions     ChatReaction[]       @relation("ChatReactions")
  courseProgress    CourseProgress[]     @relation("CourseProgress")
  eventRsvps        EventRsvp[]          @relation("EventRsvps")
  dailySteps        DailyStep[]          @relation("DailySteps")
  dailyStepCheers   DailyStepCheer[]     @relation("DailyStepCheers")
  dailyStepComments DailyStepComment[]   @relation("DailyStepComments")
  challenges        Challenge[]          @relation("Challenges")
  challengeSupports ChallengeSupport[]   @relation("ChallengeSupports")
  podcastFavorites  PodcastFavorite[]    @relation("PodcastFavorites")
  matchingPosts     MatchingPost[]       @relation("MatchingPosts")
  jobApplications   JobApplication[]     @relation("JobApplications")
  dmParticipants    DmParticipant[]      @relation("DmParticipants")
  dmMessages        DmMessage[]          @relation("DmMessages")
  authoredArticles  Article[]            @relation("ArticleAuthor")
  checkInPosts      CheckInPost[]        @relation("CheckInPosts")
  checkInPostLikes  CheckInPostLike[]    @relation("CheckInPostLikes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([membershipPlan])
  @@index([expiresAt])
}

// 管理者メモなど、User本体から分離したい付加情報
model MemberProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  adminNote String? // 管理者専用メモ（会員本人には非公開）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 会員種別マスタ（表示名・説明・将来の月額料金などを管理画面から編集できるようにする）
model MembershipPlanConfig {
  id          String         @id @default(cuid())
  plan        MembershipPlan @unique
  label       String // 画面表示名（例: 「プレミアム会員」）
  description String?
  monthlyFee  Int? // 将来の有料化に備えたフィールド（現状は未使用）
  sortOrder   Int            @default(0)
}

// Auth.js Adapter 標準モデル（将来のGoogle/LINEログイン拡張のため必須）
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// DBセッション方式（セッション固定攻撃対策としてログイン時に必ず新規発行する）
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// 動画
// ─────────────────────────────────────────

model VideoCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  videos    Video[]
}

model Video {
  id          String   @id @default(cuid())
  title       String
  thumbnailUrl String?

  // 配信方式: "upload"（サイト内ホスティング・会員限定） | "youtube"（従来のYouTube限定公開・非推奨）
  sourceType  String   @default("upload")
  youtubeUrl  String?
  youtubeId   String?
  // "upload" の場合、実ファイルは Vercel Blob に保存し、このパスはサーバー側でのみ使用する。
  // クライアントには直接公開せず、/api/videos/[id]/stream 経由（会員セッション必須）でのみ配信する。
  filePath      String?
  fileMimeType  String?
  fileSizeBytes Int?

  description String?
  tags        String? // カンマ区切り（MVPでは簡易実装。将来的にタグテーブルへ正規化可）

  categoryId String?
  category   VideoCategory? @relation(fields: [categoryId], references: [id])

  publishedAt DateTime?
  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false) // おすすめ設定

  // このコンテンツを閲覧できる会員種別（カンマ区切りで保持しアプリ層でパース）
  allowedPlans String @default("FREE,STANDARD,PREMIUM,ADMIN")

  deletedAt DateTime?

  views      VideoView[]
  favorites  VideoFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([categoryId])
}

model VideoView {
  id       String   @id @default(cuid())
  userId   String
  videoId  String
  viewedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model VideoFavorite {
  id      String @id @default(cuid())
  userId  String
  videoId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([videoId])
}

// ─────────────────────────────────────────
// ブログ・記事
// ─────────────────────────────────────────

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  articles  Article[]
}

model Article {
  id           String   @id @default(cuid())
  title        String
  eyecatchUrl  String?
  bodyHtml     String // サニタイズ済みHTML（保存前にDOMPurifyでサニタイズ）
  summary      String?
  tags         String?
  authorName   String?
  // note.com等の元記事へのリンク（任意）
  externalUrl  String?
  // 会員がチェックインページから投稿した場合の投稿者（管理者作成の場合は null）
  authorId     String?
  author       User?    @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id])

  publishedAt DateTime?
  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)

  allowedPlans String @default("FREE,STANDARD,PREMIUM,ADMIN")

  deletedAt DateTime?

  views     ArticleView[]
  favorites ArticleFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([categoryId])
}

model ArticleView {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
}

model ArticleFavorite {
  id        String @id @default(cuid())
  userId    String
  articleId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
}

// ─────────────────────────────────────────
// お知らせ
// ─────────────────────────────────────────

enum AnnouncementImportance {
  NORMAL
  IMPORTANT
}

model Announcement {
  id          String                  @id @default(cuid())
  title       String
  bodyHtml    String
  publishedAt DateTime?
  importance  AnnouncementImportance  @default(NORMAL)
  isPublished Boolean                 @default(false)
  allowedPlans String @default("FREE,STANDARD,PREMIUM,ADMIN")

  deletedAt DateTime?

  reads AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model AnnouncementRead {
  id              String   @id @default(cuid())
  userId          String
  announcementId  String
  readAt          DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
}

// ─────────────────────────────────────────
// 特典
// ─────────────────────────────────────────

model Benefit {
  id          String    @id @default(cuid())
  title       String
  summary     String?
  detailHtml  String?
  conditions  String?
  couponCode  String?
  howTo       String?
  imageUrl    String?
  validUntil  DateTime? // 期限切れは isPublished に関わらず自動で「終了」表示にする
  isPublished Boolean   @default(false)
  allowedPlans String @default("FREE,STANDARD,PREMIUM,ADMIN")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, validUntil])
}

// ─────────────────────────────────────────
// イベント
// ─────────────────────────────────────────

enum EventStatus {
  UPCOMING // 受付前
  OPEN // 受付中
  FULL // 満員
  CLOSED // 受付終了
  FINISHED // 開催終了
  CANCELED // 中止
}

model Event {
  id            String      @id @default(cuid())
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  onlineUrl     String?
  summary       String?
  capacity      Int?
  fee           String?
  applyDeadline DateTime?
  applyUrl      String? // Googleフォーム等の外部申込リンク（将来サイト内申込に拡張可能な設計）
  eyecatchUrl   String?
  status        EventStatus @default(UPCOMING)
  allowedPlans  String @default("FREE,STANDARD,PREMIUM,ADMIN")

  deletedAt DateTime?

  rsvps EventRsvp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

// ─────────────────────────────────────────
// ダウンロード資料
// ─────────────────────────────────────────

model DownloadMaterial {
  id            String   @id @default(cuid())
  title         String
  description   String?
  // ファイルは推測されにくいランダムキーで保存し、配信APIはログイン必須にする
  fileStorageKey String
  fileName      String
  thumbnailUrl  String?
  category      String?
  publishedAt   DateTime?
  isPublished   Boolean  @default(false)
  allowedPlans  String @default("FREE,STANDARD,PREMIUM,ADMIN")
  downloadCount Int      @default(0)

  deletedAt DateTime?

  logs DownloadLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DownloadLog {
  id           String   @id @default(cuid())
  userId       String
  materialId   String
  downloadedAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  material DownloadMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([userId])
}

// ─────────────────────────────────────────
// 管理ログ・サイト設定
// ─────────────────────────────────────────

model AdminLog {
  id        String   @id @default(cuid())
  actorId   String // 操作した管理者
  action    String // 例: "member.create", "member.suspend", "article.publish"
  targetType String? // 例: "User", "Article"
  targetId   String?
  detail    String? // JSON文字列で詳細を保持
  createdAt DateTime @default(now())

  actor User @relation("AdminLogActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
}

// サービス名・カラー設定など、管理画面から変更可能な設定値をKVS的に保持
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique // 例: "site.name", "theme.primaryColor"
  value String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// IPPOS Point（ポイント制度）
// ─────────────────────────────────────────
model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PointEvents", fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // マイナス値は運営による減算調整
  reason    String // "login" | "chat_post" | "event_join" | "course_complete" | "challenge_achieved" | "admin_adjust"
  refTable  String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────
// チャット（コミュニティ内チャンネル）
// ─────────────────────────────────────────
model ChatChannel {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  sortOrder   Int           @default(0)
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
}

model ChatMessage {
  id        String        @id @default(cuid())
  channelId String
  channel   ChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("ChatMessages", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ChatMessage?  @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ChatMessage[] @relation("ChatThread")
  body      String
  isPinned  Boolean       @default(false)
  deletedAt DateTime?
  createdAt DateTime      @default(now())

  reactions ChatReaction[]

  @@index([channelId, createdAt])
}

model ChatReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@id([messageId, userId, emoji])
}

// ─────────────────────────────────────────
// 講座（AI・心理学・農業 共通モデル）
// ─────────────────────────────────────────
model CourseCategory {
  id        String   @id @default(cuid())
  domain    String // "ai" | "psychology" | "agriculture"
  slug      String
  label     String
  sortOrder Int      @default(0)
  courses   Course[]

  @@unique([domain, slug])
}

model Course {
  id               String           @id @default(cuid())
  domain           String // "ai" | "psychology" | "agriculture"
  categoryId       String?
  category         CourseCategory?  @relation(fields: [categoryId], references: [id])
  title            String
  description      String?
  coverImageUrl    String?
  isPublished      Boolean          @default(false)
  pointsOnComplete Int              @default(20)
  sortOrder        Int              @default(0)
  lessons          CourseLesson[]
  quizzes          CourseQuiz[]
  progress         CourseProgress[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([domain, isPublished])
}

model CourseLesson {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  // 動画の配信方式: "youtube"（YouTube解説動画の埋め込み） | "upload"（サイト内限定配信） | "none"（動画なし）
  videoSourceType String  @default("youtube")
  videoUrl        String? // youtube の場合は動画URL
  youtubeId       String? // youtube の場合の動画ID
  filePath        String? // upload の場合の Vercel Blob パス（会員限定ストリーミング用）
  fileMimeType    String?
  pdfUrl    String?
  bodyHtml  String?
  sortOrder Int     @default(0)
}

model CourseQuiz {
  id            String @id @default(cuid())
  courseId      String
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question      String
  choicesJson   String // JSON文字列で選択肢配列を保持
  correctIndex  Int
  sortOrder     Int    @default(0)
}

model CourseProgress {
  userId               String
  user                 User      @relation("CourseProgress", fields: [userId], references: [id], onDelete: Cascade)
  courseId             String
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedLessonIds   String    @default("") // カンマ区切りのレッスンID
  progressPercent      Int       @default(0)
  completedAt          DateTime?
  updatedAt            DateTime  @updatedAt

  @@id([userId, courseId])
}

// ─────────────────────────────────────────
// イベント参加（既存Eventモデルへのサイト内参加登録を追加）
// ─────────────────────────────────────────
model EventRsvp {
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("EventRsvps", fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("going") // "going" | "canceled"
  createdAt DateTime @default(now())

  @@id([eventId, userId])
}

// ─────────────────────────────────────────
// 一歩記録（日々の小さな挑戦の記録）
// ─────────────────────────────────────────
model DailyStep {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation("DailySteps", fields: [userId], references: [id], onDelete: Cascade)
  body      String
  imageUrl  String?
  createdAt DateTime           @default(now())
  cheers    DailyStepCheer[]
  comments  DailyStepComment[]

  @@index([createdAt])
}

model DailyStepCheer {
  stepId    String
  step      DailyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("DailyStepCheers", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([stepId, userId])
}

model DailyStepComment {
  id        String    @id @default(cuid())
  stepId    String
  step      DailyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("DailyStepComments", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────
// 挑戦宣言（今月の目標宣言と応援）
// ─────────────────────────────────────────
model Challenge {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation("Challenges", fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  deadline        DateTime
  progressPercent Int                 @default(0)
  isAchieved      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  supports        ChallengeSupport[]
}

model ChallengeSupport {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("ChallengeSupports", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([challengeId, userId])
}

// ─────────────────────────────────────────
// Podcast
// ─────────────────────────────────────────
model PodcastSeries {
  id            String            @id @default(cuid())
  title         String
  description   String?
  coverImageUrl String?
  sortOrder     Int               @default(0)
  episodes      PodcastEpisode[]
}

model PodcastEpisode {
  id              String             @id @default(cuid())
  seriesId        String
  series          PodcastSeries      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  audioUrl        String
  durationSeconds Int?
  publishedAt     DateTime           @default(now())
  favorites       PodcastFavorite[]
}

model PodcastFavorite {
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("PodcastFavorites", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([episodeId, userId])
}

// ─────────────────────────────────────────
// マッチング（募集掲示板）
// ─────────────────────────────────────────
model MatchingPost {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation("MatchingPosts", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  category    String // "designer" | "engineer" | "farm-experience" | "co-founder" | "other"
  description String?
  status      String    @default("open") // "open" | "closed"
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

// ─────────────────────────────────────────
// 求人
// ─────────────────────────────────────────
model JobPost {
  id             String            @id @default(cuid())
  companyName    String
  companyLogoUrl String?
  title          String
  employmentType String // "intern" | "part-time" | "contract" | "full-time"
  location       String?
  description    String?
  status         String            @default("pending") // "pending" | "published" | "closed"
  createdAt      DateTime          @default(now())
  applications   JobApplication[]

  @@index([status, createdAt])
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  job         JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation("JobApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  message     String?
  status      String   @default("submitted") // "submitted" | "reviewing" | "accepted" | "rejected"
  createdAt   DateTime @default(now())

  @@index([jobId])
}

// ─────────────────────────────────────────
// チェックイン（会員が気軽に情報をシェアする短文投稿）
// ─────────────────────────────────────────
model CheckInPost {
  id        String            @id @default(cuid())
  authorId  String
  author    User              @relation("CheckInPosts", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageUrl  String?
  createdAt DateTime          @default(now())
  likes     CheckInPostLike[]
}

model CheckInPostLike {
  postId    String
  post      CheckInPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("CheckInPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([postId, userId])
}

// ─────────────────────────────────────────
// 会員間ダイレクトメッセージ（管理者はすべて閲覧可能）
// ─────────────────────────────────────────
model DmThread {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  participants DmParticipant[]
  messages     DmMessage[]
}

model DmParticipant {
  threadId  String
  thread    DmThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("DmParticipants", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([threadId, userId])
}

model DmMessage {
  id        String    @id @default(cuid())
  threadId  String
  thread    DmThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation("DmMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
}

