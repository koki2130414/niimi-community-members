# ── データベース ──────────────────────────────────
# 開発環境: SQLite（そのままでOK）
# 本番環境: PostgreSQLの接続文字列に変更してください
# 例: postgresql://user:password@host:5432/niimi_community?schema=public
DATABASE_URL="file:./dev.db"

# ── Auth.js (NextAuth) ───────────────────────────
# 32文字以上のランダムな文字列を設定してください。
# 生成例: openssl rand -base64 32
AUTH_SECRET="please-change-this-to-a-random-secret-value"

# 本番環境のURL（例: https://members.example.com）
AUTH_URL="http://localhost:3000"

# ── サイト基本設定（管理画面からも変更可能） ──────
NEXT_PUBLIC_SITE_NAME="にいみコミュニティ メンバーズ"

# ── ファイル保存（将来のクラウドストレージ移行用。MVPではローカル保存） ──
# 本番運用時はS3 / Cloudflare R2 等のクレデンシャルをここに追加してください
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
